<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).
    For Android 11 and below the exclusions are in backup_rules.xml.
    See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Auth tokens stored in DataStore — must never be backed up to the cloud -->
        <exclude domain="file" path="datastore/secure_user_prefs.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <!-- Auth tokens are device-specific and must not be transferred to another device -->
        <exclude domain="file" path="datastore/secure_user_prefs.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
