<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 11 (API 30) and below.
    For Android 12+ (API 31+) the exclusions are in data_extraction_rules.xml.
    See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Auth tokens stored in DataStore — must never be restored on another device -->
    <exclude domain="file" path="datastore/secure_user_prefs.preferences_pb"/>
</full-backup-content>
